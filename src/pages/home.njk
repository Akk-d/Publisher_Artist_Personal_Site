---
layout: layouts/base.njk
pageKey: home
pagination: { data: entries.home, size: 1, alias: entry, addAllPagesToCollections: true }
hasViewer: true
styles: ["/css/home.css"]
scripts: ["/js/viewer.js", "/js/masonry.js", "/js/home-bg.js"]
---
{% from "components/macros.njk" import bookCard, paintingFrame %}
<main>
<div class="stage"><canvas id="bg" aria-hidden="true"></canvas>
<div class="wrap hero">
 <div class="reveal"><div class="kicker">{{ t.kick }}</div><h1>{{ t.hero_name }}</h1>
  <svg class="ink-line" viewBox="0 0 340 18" fill="none" aria-hidden="true"><path d="M2 12 C60 2, 110 16, 170 9 S290 4, 338 11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
  <p class="lede">{{ t.lede }}</p></div>
 <div class="prints" role="img" aria-label="{{ t.portrait_label }}"><div class="print b torn"><div class="ph"><img class="ph-img" src="{{ '/assets/images/dr/portrait.jpg' | asset }}" width="960" height="1280" alt=""></div></div><div class="print torn"><div class="ph"><img class="ph-img" src="{{ '/assets/images/dr/standing.jpg' | asset }}" width="960" height="1280" alt=""></div></div></div>
</div></div>
<section id="about" style="padding-top:1rem"><div class="wrap"><div class="about one"><div><p class="drop">{{ t.about_text }}</p><p><a class="btn ghost" href="{{ '/biography/' | href(lang) }}">{{ t.read_bio }}</a></p></div></div></div></section>
<section id="books" style="padding-top:1rem"><div class="wrap"><h2>{{ t.h_books }}</h2><p class="sub">{{ t.s_books }}</p>{% for part in t.bio.parts %}{% if part.works %}<ol class="home-works">{% for w in part.works %}<li>{% if w.slug %}<a href="{{ ('/books/' + w.slug + '/') | href(lang) }}">{{ w.t }}</a>{% else %}<span>{{ w.t }}</span>{% endif %}{% if w.soon %} <span class="soon">{{ t.bio.soon }}</span>{% endif %}</li>{% endfor %}</ol>{% endif %}{% endfor %}<div class="shelf">{% for b in books | shelf %}{{ bookCard(b, t.books[b.slug], lang, t.name) }}{% endfor %}</div><p class="more"><a class="btn ghost" href="{{ '/books/' | href(lang) }}">{{ t.all_books }}</a></p></div></section>
<section id="paintings" class="paint"><div class="wrap paint-feature"><div class="paint-head"><h2>{{ t.h_paint }}</h2><p class="sub">{{ t.s_paint2 }}</p></div><div class="gal gal-home">{% for p in paintings | selectattr("home") | sort(false, false, "home") %}{{ paintingFrame(p, t.palt[p.id]) }}{% endfor %}</div><p class="more"><a class="btn ghost" href="{{ '/paintings/' | href(lang) }}">{{ t.all_paint }}</a></p><figure class="paint-artist"><img src="{{ '/assets/images/dr/studio.jpg' | asset }}" width="1600" height="901" alt="{{ t.photos.studio.alt }}" loading="lazy" decoding="async"></figure></div></section>
{% if t.q %}<section><div class="wrap"><blockquote><span>{{ t.q }}</span><cite>{{ t.qc }}</cite></blockquote></div></section>{% endif %}
<section id="film" class="film"><div class="wrap"><h2>{{ t.h_film }}</h2><p class="sub">{{ t.s_film }}</p><figure class="film-frame"><video controls preload="none" playsinline poster="{{ '/assets/video/portraits-poster.jpg' | asset }}" width="1024" height="576" aria-label="{{ t.film_label }}"><source src="{{ '/assets/video/portraits.mp4' | asset }}" type="video/mp4"></video></figure></div></section>
</main>
