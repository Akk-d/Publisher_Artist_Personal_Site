---
layout: layouts/base.njk
pageKey: book
navKey: books
pagination: { data: entries.book, size: 1, alias: entry, addAllPagesToCollections: true }
---
{% from "components/macros.njk" import bookCard, bookCover %}
{% set bt = t.books[book.slug] %}
{% macro descItem(item) %}{% if item is string %}<p>{{ item }}</p>{% elif item.h %}<h3>{{ item.h }}</h3>{% else %}<p class="verse"><span>{{ item[0] }}</span><span>{{ item[1] }}</span></p>{% endif %}{% endmacro %}
<main id="app"><div class="wrap bookpg"><div>{{ bookCover(book, bt, true) }}</div><div><a class="type" href="{{ '/books/' | href(lang) }}">{{ t.back }}</a><h1>{{ bt.title }}</h1>{% if bt.sub %}<p class="book-sub">{{ bt.sub }}</p>{% endif %}<p class="byline">{{ t.by }} <strong>{{ t.hero_name }}</strong></p>{% if bt.pub or book.year or book.pages or book.isbn %}<dl class="meta">{% if bt.pub %}<dt>{{ t.m_pub }}</dt><dd>{{ bt.pub }}</dd>{% endif %}{% if book.year %}<dt>{{ t.m_year }}</dt><dd>{{ book.year }}</dd>{% endif %}{% if book.pages %}<dt>{{ t.m_pages }}</dt><dd>{{ book.pages }}</dd>{% endif %}{% if book.isbn %}<dt>{{ t.m_isbn }}</dt><dd>{{ book.isbn }}</dd>{% endif %}</dl>{% endif %}<p class="drop">{{ bt.d1 }}</p>{% if bt.d2 %}<p>{{ bt.d2 }}</p>{% endif %}<div class="book-actions"><button class="btn is-soon" type="button" disabled>{{ t.read }} <small>{{ t.soon_tag }}</small></button>{% if book.buy %}<a class="btn" href="{{ book.buy }}">{{ t.buy }}</a>{% endif %}{% if book.excerpt %}<a class="btn ghost" href="{{ book.excerpt }}">{{ t.exc }}</a>{% endif %}</div>{% if book.shops %}<div class="shops type"><span>{{ t.also }}</span> {% for s in book.shops %}<a href="{{ s.url }}">{{ s.name }}</a>{% endfor %}</div>{% endif %}
{% if bt.desc %}<section class="book-about" aria-labelledby="about-h"><h2 id="about-h">{{ t.about }}</h2>{% for item in bt.desc.slice(0, 3) %}{{ descItem(item) }}{% endfor %}{% if bt.desc.length > 3 %}<details class="book-more"><summary>{{ t.read_full }}</summary>{% for item in bt.desc.slice(3) %}{{ descItem(item) }}{% endfor %}</details>{% endif %}</section>{% endif %}</div></div>
<section style="padding-top:1rem"><div class="wrap"><h2>{{ t.h_more }}</h2><div class="shelf" style="margin-top:1.5rem">{% for b in books | shelf(book.slug) %}{{ bookCard(b, t.books[b.slug], lang, t.name) }}{% endfor %}</div><p class="more"><a class="btn ghost" href="{{ '/books/' | href(lang) }}">{{ t.all_books }}</a></p></div></section>
</main>
