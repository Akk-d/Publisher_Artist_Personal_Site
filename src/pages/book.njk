---
layout: layouts/base.njk
pageKey: book
navKey: books
pagination: { data: entries.book, size: 1, alias: entry, addAllPagesToCollections: true }
---
{% from "components/macros.njk" import bookCard, bookCover %}
{% set bt = t.books[book.slug] %}
<main id="app"><div class="wrap bookpg"><div>{{ bookCover(book, bt, true) }}</div><div><a class="type" href="{{ '/books/' | href(lang) }}">{{ t.back }}</a><h1>{{ bt.title }}</h1><dl class="meta"><dt>{{ t.m_pub }}</dt><dd>{{ bt.pub }}</dd>{% if book.year %}<dt>{{ t.m_year }}</dt><dd>{{ book.year }}</dd>{% endif %}{% if book.pages %}<dt>{{ t.m_pages }}</dt><dd>{{ book.pages }}</dd>{% endif %}{% if book.isbn %}<dt>{{ t.m_isbn }}</dt><dd>{{ book.isbn }}</dd>{% endif %}</dl><p class="drop">{{ bt.d1 }}</p><p>{{ bt.d2 }}</p>{% if book.buy %}<a class="btn" href="{{ book.buy }}">{{ t.buy }}</a>{% endif %}{% if book.excerpt %}<a class="btn ghost" href="{{ book.excerpt }}">{{ t.exc }}</a>{% endif %}{% if book.shops %}<div class="shops type"><span>{{ t.also }}</span> {% for s in book.shops %}<a href="{{ s.url }}">{{ s.name }}</a>{% endfor %}</div>{% endif %}</div></div>
<section style="padding-top:1rem"><div class="wrap"><h2>{{ t.h_more }}</h2><div class="shelf" style="margin-top:1.5rem">{% for b in books %}{% if b.slug != book.slug %}{{ bookCard(b, t.books[b.slug], lang) }}{% endif %}{% endfor %}</div></div></section>
</main>
