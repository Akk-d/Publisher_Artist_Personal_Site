{%- if site.preview %}<div class="note">{{ t.note }}</div>{% endif %}
<header><nav class="wrap"><div class="links" id="links"><a href="{{ '/' | href(lang) }}#about">{{ t.n_about }}</a><a href="{{ '/books/' | href(lang) }}"{% if navKey == 'books' %} aria-current="page"{% endif %}>{{ t.n_books }}</a><a href="{{ '/paintings/' | href(lang) }}"{% if navKey == 'paintings' %} aria-current="page"{% endif %}>{{ t.n_paint }}</a><a href="#contact">{{ t.n_contact }}</a></div><div class="tools"><button id="menu" aria-expanded="false" aria-controls="links">{{ t.menu }}</button><div class="lang" role="group" aria-label="{{ t.lang_label }}">{% for l in languages %}<a href="{{ route | href(l) }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.code == lang.code %} aria-current="true"{% endif %}>{{ l.label }}</a>{% endfor %}</div></div></nav></header>
