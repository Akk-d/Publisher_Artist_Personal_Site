{% macro bookCover(b, bt, eager) %}{% if b.image %}<span class="bk-frame"><span class="bk"><img class="cover-img" src="{{ b.image | asset }}" width="{{ b.w }}" height="{{ b.h }}" alt="{{ bt.title }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %}></span></span>{% else %}<div class="cover {{ b.cover }}"><small>{{ b.publisher }}</small><strong>{{ bt.title }}</strong><small>{{ b.year }}</small></div>{% endif %}{% endmacro %}
{% macro bookCard(b, bt, lang, by) %}<a class="book" href="{{ ('/books/' + b.slug + '/') | href(lang) }}">{{ bookCover(b, bt) }}<h3>{{ bt.title }}</h3><p>{{ by }}</p></a>{% endmacro %}
{% macro paintingFrame(p, alt) %}<figure class="frame{% if p.cut %} cutout{% endif %}" tabindex="0"{% if p.w %} style="--r:{{ (p.w / p.h) | round(3) }}"{% endif %}><span class="pin">{% if p.thumb %}<img src="{{ p.thumb | asset }}" data-full="{{ p.full | asset }}" width="{{ p.w }}" height="{{ p.h }}" alt="{{ alt }}" loading="lazy">{% else %}{{ p.svg | safe }}{% endif %}</span></figure>{% endmacro %}
